     public Collection<ServerPlayer> getPlayers() {
         return this.unmodifiablePlayers;
     }
+
+    // KioCG start - entity bossbar api
+    public net.minecraft.nbt.CompoundTag save(net.minecraft.core.HolderLookup.Provider levelRegistry) {
+        net.minecraft.nbt.CompoundTag compoundTag = new net.minecraft.nbt.CompoundTag();
+        compoundTag.putString("Name", Component.Serializer.toJson(this.name, levelRegistry));
+        compoundTag.putBoolean("Visible", this.isVisible());
+        compoundTag.putString("Color", this.getColor().getName());
+        compoundTag.putString("Overlay", this.getOverlay().getName());
+        compoundTag.putBoolean("DarkenScreen", this.shouldDarkenScreen());
+        compoundTag.putBoolean("PlayBossMusic", this.shouldPlayBossMusic());
+        compoundTag.putBoolean("CreateWorldFog", this.shouldCreateWorldFog());
+        return compoundTag;
+    }
+
+    public static ServerBossEvent load(net.minecraft.nbt.CompoundTag tag, net.minecraft.core.HolderLookup.Provider levelRegistry) {
+        Component name = Component.Serializer.fromJson(tag.getString("Name"), levelRegistry);
+        BossBarColor color = BossBarColor.byName(tag.getString("Color"));
+        BossBarOverlay overlay = BossBarOverlay.byName(tag.getString("Overlay"));
+        ServerBossEvent serverBossEvent = new ServerBossEvent(name, color, overlay);
+
+        serverBossEvent.setVisible(tag.getBoolean("Visible"));
+        serverBossEvent.setDarkenScreen(tag.getBoolean("DarkenScreen"));
+        serverBossEvent.setPlayBossMusic(tag.getBoolean("PlayBossMusic"));
+        serverBossEvent.setCreateWorldFog(tag.getBoolean("CreateWorldFog"));
+        return serverBossEvent;
+    }
+    // KioCG end - entity bossbar api
 }
