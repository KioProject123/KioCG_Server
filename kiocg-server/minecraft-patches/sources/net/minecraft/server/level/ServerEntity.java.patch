+    // KioCG start - hide entity attribute
+    public void broadcastHideAttribute(java.util.function.Supplier<Packet<?>> packetReal, java.util.function.Supplier<Packet<?>> packetFake) {
+        for (net.minecraft.server.network.ServerPlayerConnection serverPlayerConnection : this.trackedPlayers) {
+            if (!this.entity.hideAttributeFor(serverPlayerConnection.getPlayer())) {
+                serverPlayerConnection.send(packetReal.get());
+            } else {
+                serverPlayerConnection.send(packetFake.get());
+            }
+        }
+        if (this.entity instanceof ServerPlayer) {
+            ((ServerPlayer) this.entity).connection.send(packetReal.get());
+        }
+    }
+
+    private static final AttributeInstance DUMMY_MAX_HEALTH = new AttributeInstance(net.minecraft.world.entity.ai.attributes.Attributes.MAX_HEALTH, (attribute) -> { });
+    private static final AttributeInstance DUMMY_MAX_ABSORPTION = new AttributeInstance(net.minecraft.world.entity.ai.attributes.Attributes.MAX_ABSORPTION, (attribute) -> { });
+    private static final AttributeInstance DUMMY_ARMOR = new AttributeInstance(net.minecraft.world.entity.ai.attributes.Attributes.ARMOR, (attribute) -> { });
+    private static final AttributeInstance DUMMY_ARMOR_TOUGHNESS = new AttributeInstance(net.minecraft.world.entity.ai.attributes.Attributes.ARMOR_TOUGHNESS, (attribute) -> { });
+    private static final java.util.Map<net.minecraft.core.Holder<net.minecraft.world.entity.ai.attributes.Attribute>, AttributeInstance> HIDE_ATTRIBUTE = java.util.Map.of(
+            net.minecraft.world.entity.ai.attributes.Attributes.MAX_HEALTH, DUMMY_MAX_HEALTH,
+            net.minecraft.world.entity.ai.attributes.Attributes.MAX_ABSORPTION, DUMMY_MAX_ABSORPTION,
+            net.minecraft.world.entity.ai.attributes.Attributes.ARMOR, DUMMY_ARMOR,
+            net.minecraft.world.entity.ai.attributes.Attributes.ARMOR_TOUGHNESS, DUMMY_ARMOR_TOUGHNESS);
+
+    private void hideAttribute(Collection<AttributeInstance> collection, boolean force) {
+        List<AttributeInstance> list = new ArrayList<>(HIDE_ATTRIBUTE.size());
+
+        java.util.Iterator<AttributeInstance> iterator = collection.iterator();
+        while (iterator.hasNext()) {
+            AttributeInstance genericInstance = iterator.next();
+            AttributeInstance hide = HIDE_ATTRIBUTE.get(genericInstance.getAttribute());
+            if (hide != null) {
+                iterator.remove();
+                list.add(hide);
+            }
+        }
+
+        if (!force) {
+            collection.addAll(list);
+        } else {
+            HIDE_ATTRIBUTE.forEach((holder, attribute) -> {
+                if (((LivingEntity) this.entity).getAttributes().hasAttribute(holder)) {
+                    collection.add(attribute);
+                }
+            });
+        }
+    }
+
+    private void hideHealth(List<SynchedEntityData.DataValue<?>> trackedDataValues) {
+        java.util.ListIterator<SynchedEntityData.DataValue<?>> iterator = trackedDataValues.listIterator();
+        while (iterator.hasNext()) {
+            SynchedEntityData.DataValue<?> dataValue = iterator.next();
+            if (dataValue.id() == LivingEntity.DATA_HEALTH_ID.id()) {
+                iterator.set(new SynchedEntityData.DataValue<>(LivingEntity.DATA_HEALTH_ID.id(), net.minecraft.network.syncher.EntityDataSerializers.FLOAT, (float) DUMMY_MAX_HEALTH.getBaseValue()));
+                break;
+            }
+        }
+    }
+    // KioCG end - hide entity attribute
