+    private boolean enableFreshness(long tickTime, boolean applyDamage) {
+        if (hasFreshness() && !this.isBroken()) {
+            CustomData stackableCustomData = this.getOrDefault(DataComponents.STACKABLE_CUSTOM_DATA, CustomData.EMPTY);
+            Optional<Long> foodTickTime = stackableCustomData.getUnsafe().getLong("FoodTickTime");
+            if (foodTickTime.isEmpty() || foodTickTime.get() != tickTime) {
+                if (applyDamage) {
+                    tickFreshness(tickTime, foodTickTime.orElse(tickTime - 1));
+                }
+
+                stackableCustomData = stackableCustomData.update(tag -> tag.putLong("FoodTickTime", tickTime));
+                this.set(DataComponents.STACKABLE_CUSTOM_DATA, stackableCustomData);
+                return true;
+            }
+        }
+        return false;
+    }
+
+    public boolean hopperEnableFreshness(long tickTime) {
+        if (hasFreshness() && !this.isBroken()) {
+            CustomData stackableCustomData = this.getOrDefault(DataComponents.STACKABLE_CUSTOM_DATA, CustomData.EMPTY);
+            if (!stackableCustomData.getUnsafe().contains("FoodTickTime")) {
+                stackableCustomData = stackableCustomData.update(tag -> tag.putLong("FoodTickTime", tickTime));
+                this.set(DataComponents.STACKABLE_CUSTOM_DATA, stackableCustomData);
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private boolean disableFreshness(long tickTime, boolean applyDamage) {
+        CustomData stackableCustomData = this.getOrDefault(DataComponents.STACKABLE_CUSTOM_DATA, CustomData.EMPTY);
+        Optional<Long> foodTickTime = stackableCustomData.getUnsafe().getLong("FoodTickTime");
+        if (foodTickTime.isPresent()) {
+            if (applyDamage && hasFreshness() && !this.isBroken()) {
+                tickFreshness(tickTime, foodTickTime.orElse(tickTime - 1));
+            }
+
+            stackableCustomData = stackableCustomData.update(tag -> tag.remove("FoodTickTime"));
+            this.set(DataComponents.STACKABLE_CUSTOM_DATA, stackableCustomData);
+            return true;
+        }
+        return false;
+    }
+
+    private void tickFreshness(long tickTime, long prevTickTime) {
+        if (prevTickTime < tickTime) {
+            int spend = spendFreshness(prevTickTime + 1, tickTime, io.papermc.paper.configuration.GlobalConfiguration.get().kiocgConfig.foodFreshnessTickInterval);
+            if (spend != 0) {
+                this.setDamageValue(this.getDamageValue() + spend);
+            }
+        }
+    }
+
+    private static int spendFreshness(long start, long end, int interval) {
+        int startPoint = (int) Math.ceilDiv(start, interval);
+        int endPoint = (int) Math.floorDiv(end, interval);
+        return endPoint - startPoint + 1;
+    }
