+    // KioCG start - food freshness
+    public static boolean isSameItemSameComponentsForFoodFreshness(ItemStack stack, ItemStack other) {
+        if (!isSameItem(stack, other)) return false;
+        if (stack.isEmpty() && other.isEmpty()) return true;
+
+        if (stack.hasFreshness()) {
+            Integer prevDamage = stack.get(DataComponents.DAMAGE);
+            stack.set(DataComponents.DAMAGE, other.get(DataComponents.DAMAGE));
+            boolean sameComponents = isSameComponents(stack.components, other.components);
+            stack.set(DataComponents.DAMAGE, prevDamage);
+            return sameComponents;
+        } else {
+            return isSameComponents(stack.components, other.components);
+        }
+    }
