+    // KioCG start - customize default components
+    private static boolean isSameComponents(PatchedDataComponentMap stack, PatchedDataComponentMap other) {
+        if (stack == other) return true;
+
+        CustomData prevStackableData = stack.get(DataComponents.STACKABLE_CUSTOM_DATA);
+        stack.set(DataComponents.STACKABLE_CUSTOM_DATA, other.get(DataComponents.STACKABLE_CUSTOM_DATA));
+        boolean sameComponents = stack.equals(other);
+        stack.set(DataComponents.STACKABLE_CUSTOM_DATA, prevStackableData);
+        return sameComponents;
+    }
