+    // KioCG start - customize default components
+    public DataComponentPatch getRemoteComponentsPatch() {
+        if (!this.isEmpty()) {
+            DataComponentPatch.Builder builder = DataComponentPatch.builder();
+            builder.copy(this.getItem().componentsPatchRemote());
+
+            boolean changed = false;
+            DataComponentPatch patch = this.components.asPatch();
+            for (java.util.Map.Entry<DataComponentType<?>, Optional<?>> entry : patch.entrySet()) {
+                if (!DataComponents.UNABLE_SEND_TO_CLIENT.contains(entry.getKey())) {
+                    entry.getValue().ifPresentOrElse(value -> builder.set((DataComponentType) entry.getKey(), value), () -> builder.remove(entry.getKey()));
+                } else {
+                    changed = true;
+                }
+            }
+
+            if (saveAdditional(builder) || changed) {
+                CustomData customData = this.getOrDefault(DataComponents.CUSTOM_DATA, CustomData.EMPTY);
+                customData = customData.update(tag -> {
+                    RegistryOps<Tag> registryOps = net.minecraft.server.MinecraftServer.getServer().registryAccess().createSerializationContext(NbtOps.INSTANCE);
+                    tag.store("KioCG.OriginalComponents", DataComponentPatch.CODEC, registryOps, patch);
+                });
+                builder.set(DataComponents.CUSTOM_DATA, customData);
+            }
+
+            return builder.build();
+        }
+        return DataComponentPatch.EMPTY;
+    }
+
+    private boolean saveAdditional(DataComponentPatch.Builder builder) {
+        boolean changed = false;
+
+        net.minecraft.world.item.component.ItemLore extendedBeforeLore = this.getOrDefault(DataComponents.EXTENDED_BEFORE_LORE, net.minecraft.world.item.component.ItemLore.EMPTY);
+        net.minecraft.world.item.component.ItemLore extendedAfterLore = this.getOrDefault(DataComponents.EXTENDED_AFTER_LORE, net.minecraft.world.item.component.ItemLore.EMPTY);
+        if (!extendedBeforeLore.lines().isEmpty() || !extendedAfterLore.lines().isEmpty()) {
+            net.minecraft.world.item.component.ItemLore lore = this.getOrDefault(DataComponents.LORE, net.minecraft.world.item.component.ItemLore.EMPTY);
+            List<Component> lores = new java.util.ArrayList<>();
+            lores.addAll(extendedBeforeLore.lines());
+            lores.addAll(lore.lines());
+            lores.addAll(extendedAfterLore.lines());
+            builder.set(DataComponents.LORE, new net.minecraft.world.item.component.ItemLore(lores));
+            changed = true;
+        }
+
+        return changed;
+    }
+    // KioCG end - customize default components
