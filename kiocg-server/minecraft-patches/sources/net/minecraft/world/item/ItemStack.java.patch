+
+    private boolean deepTick(java.util.function.Supplier<Boolean> supplier, int deep) {
+        if (!this.isEmpty() && deep <= 1) {
+            boolean changed = false;
+
+            net.minecraft.world.item.component.BundleContents bundleContents = this.get(DataComponents.BUNDLE_CONTENTS);
+            if (bundleContents != null) {
+                boolean changed1 = false;
+                for (ItemStack itemStack : bundleContents.items()) {
+                    if (itemStack.deepTick(supplier, deep + 1)) {
+                        changed1 = true;
+                    }
+                }
+                // 创建一个新的对象, 避免编码缓存导致的问题
+                if (changed1) {
+                    this.set(DataComponents.BUNDLE_CONTENTS, new net.minecraft.world.item.component.BundleContents((List<ItemStack>) bundleContents.items()));
+                    changed = true;
+                }
+            }
+
+            ItemContainerContents container = this.get(DataComponents.CONTAINER);
+            if (container != null) {
+                boolean changed1 = false;
+                for (ItemStack itemStack : container.nonEmptyItems()) {
+                    if (itemStack.deepTick(supplier, deep + 1)) {
+                        changed1 = true;
+                    }
+                }
+                // 创建一个新的对象, 避免编码缓存导致的问题
+                if (changed1) {
+                    this.set(DataComponents.CONTAINER, ItemContainerContents.fromItems(container.items));
+                    changed = true;
+                }
+            }
+
+            return supplier.get() || changed;
+        }
+        return false;
+    }
