+        net.minecraft.world.item.component.ItemLore extendedAfterLore = this.getOrDefault(DataComponents.EXTENDED_AFTER_LORE, net.minecraft.world.item.component.ItemLore.EMPTY);
+        if (!extendedBeforeLore.lines().isEmpty() || !extendedAfterLore.lines().isEmpty()) {
+            net.minecraft.world.item.component.ItemLore lore = this.getOrDefault(DataComponents.LORE, net.minecraft.world.item.component.ItemLore.EMPTY);
+            List<Component> lores = new java.util.ArrayList<>();
+            lores.addAll(extendedBeforeLore.lines());
+            lores.addAll(lore.lines());
+            lores.addAll(extendedAfterLore.lines());
+            builder.set(DataComponents.LORE, new net.minecraft.world.item.component.ItemLore(lores));
+            changed = true;
+        }
+
+        return changed;
+    }
