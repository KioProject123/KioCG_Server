+    public boolean deepTick(java.util.function.Function<ItemStack, Boolean> function, int maxDepth) {
+        if (!this.isEmpty() && maxDepth >= 0) {
+            boolean changed = false;
+
+            net.minecraft.world.item.component.BundleContents bundleContents = this.get(DataComponents.BUNDLE_CONTENTS);
+            if (bundleContents != null) {
+                boolean changed1 = false;
+                List<ItemStack> result = new java.util.ArrayList<>(bundleContents.size());
+                for (ItemStack itemStack : bundleContents.items()) {
+                    // 如果不进行克隆, 保存时可能丢失数据
+                    result.add(itemStack = itemStack.copy());
+                    if (itemStack.deepTick(function, maxDepth - 1)) {
+                        changed1 = true;
+                    }
+                }
+                if (changed1) {
+                    this.set(DataComponents.BUNDLE_CONTENTS, new net.minecraft.world.item.component.BundleContents(List.copyOf(result)));
+                    changed = true;
+                }
+            }
+
+            ItemContainerContents container = this.get(DataComponents.CONTAINER);
+            if (container != null) {
+                boolean changed1 = false;
+                List<ItemStack> result = new java.util.ArrayList<>(container.items.size());
+                for (ItemStack itemStack : container.items) {
+                    // 如果不进行克隆, 保存时可能丢失数据
+                    result.add(itemStack = itemStack.copy());
+                    if (itemStack.deepTick(function, maxDepth - 1)) {
+                        changed1 = true;
+                    }
+                }
+                if (changed1) {
+                    this.set(DataComponents.CONTAINER, ItemContainerContents.fromItems(List.copyOf(result)));
+                    changed = true;
+                }
+            }
+
+            changed |= function.apply(this);
+            return changed;
+        }
+        return false;
+    }
