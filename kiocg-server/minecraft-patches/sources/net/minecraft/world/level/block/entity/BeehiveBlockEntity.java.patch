+    // KioCG start - beehive refill every night
+    private static int calculateNewHoneyLevel(Level level, BlockPos pos, int honeyLevel) {
+        int xOff = pos.getX();
+        int yOff = pos.getY();
+        int zOff = pos.getZ();
+        for (int dz = -4; dz <= 4; ++dz) {
+            int z = dz + zOff;
+            for (int dx = -4; dx <= 4; ++dx) {
+                int x = xOff + dx;
+                for (int dy = -2; dy <= 0; ++dy) {
+                    int y = dy + yOff;
+                    net.minecraft.world.level.chunk.LevelChunk chunk = level.getChunk(x >> 4, z >> 4);
+                    BlockState blockStateFinal = chunk.getBlockStateFinal(x, y, z);
+                    if (Bee.attractsBees(blockStateFinal) && ++honeyLevel >= BeehiveBlock.MAX_HONEY_LEVELS) {
+                        return BeehiveBlock.MAX_HONEY_LEVELS;
+                    }
+                }
+            }
+        }
+        return honeyLevel;
+    }
+    // KioCG end - beehive refill every night
