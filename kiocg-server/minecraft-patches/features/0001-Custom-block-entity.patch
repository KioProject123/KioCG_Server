+
+// KioCG start - custom block entity: all class
+public interface FlowerPotInteraction {
+    double pixel1 = 1.0 / 16.0, pixel2 = 2.0 / 16.0, pixel3 = 3.0 / 16.0, pixel4 = 4.0 / 16.0;
+    double pixel5 = 5.0 / 16.0, pixel6 = 6.0 / 16.0, pixel7 = 7.0 / 16.0, pixel8 = 8.0 / 16.0;
+    double pixel9 = 9.0 / 16.0, pixel10 = 10.0 / 16.0, pixel11 = 11.0 / 16.0, pixel12 = 12.0 / 16.0;
+    double pixel13 = 13.0 / 16.0, pixel14 = 14.0 / 16.0, pixel15 = 15.0 / 16.0, pixel16 = 16.0 / 16.0;
+
+    Consumer<Display.BlockDisplay> interact(Level level, BlockPos pos, Block block);
+
+    Object2ObjectOpenHashMap<Block, FlowerPotInteraction> map = new Object2ObjectOpenHashMap<>();
+
+    static Optional<Consumer<Display.BlockDisplay>> get(Level level, BlockPos pos, Block block) {
+        FlowerPotInteraction flowerPotInteraction = FlowerPotInteraction.map.get(block);
+        return Optional.ofNullable(flowerPotInteraction.interact(level, pos, block));
+    }
+
+    static void bootStrap() {
+        map.defaultReturnValue(FlowerPotInteraction::defaultInteraction);
+        map.put(Blocks.PALE_HANGING_MOSS, FlowerPotInteraction::hangingInteraction);
+        map.put(Blocks.SMALL_AMETHYST_BUD, (level, pos, block) -> consumer(block.defaultBlockState(), 0.65));
+        map.put(Blocks.MEDIUM_AMETHYST_BUD, (level, pos, block) -> consumer(block.defaultBlockState(), 0.65));
+        map.put(Blocks.LARGE_AMETHYST_BUD, FlowerPotInteraction::normalInteraction);
+        map.put(Blocks.AMETHYST_CLUSTER, FlowerPotInteraction::normalInteraction);
+        map.put(Blocks.SHORT_GRASS, FlowerPotInteraction::normalInteraction);
+        map.put(Blocks.PINK_PETALS, (level, pos, block) -> blockDisplay -> {
+            double size = 0.7;
+            blockDisplay.setScale(new Vector3f((float) size, 1.0F, (float) size));
+            blockDisplay.setTranslation(new Vector3f((float) (pixel8 - pixel4 * size), (float) pixel4, (float) (pixel8 - pixel4 * size)));
+            blockDisplay.setBlockState(block.defaultBlockState());
+        });
+        map.put(Blocks.SPORE_BLOSSOM, (level, pos, block) -> consumer(block.defaultBlockState(), pixel6 / pixel12).andThen(consumerInvert()).andThen(consumerFlat()));
+        map.put(Blocks.SUGAR_CANE, (level, pos, block) -> consumer(block.defaultBlockState(), 0.45, pixel12, 0.45));
+        map.put(Blocks.NETHER_SPROUTS, (level, pos, block) -> consumer(block.defaultBlockState(), 0.45));
+        map.put(Blocks.WEEPING_VINES, (level, pos, block) -> consumer(Blocks.WEEPING_VINES_PLANT.defaultBlockState()).andThen(consumerInvert()));
+        map.put(Blocks.TWISTING_VINES, (level, pos, block) -> normalInteraction(level, pos, Blocks.TWISTING_VINES_PLANT));
+        map.put(Blocks.VINE, FlowerPotInteraction::sphericalInteraction);
+        map.put(Blocks.TALL_GRASS, FlowerPotInteraction::doublePlantInteraction);
+        map.put(Blocks.LARGE_FERN, FlowerPotInteraction::doublePlantInteraction);
+        map.put(Blocks.SUNFLOWER, FlowerPotInteraction::doublePlantInteraction);
+        map.put(Blocks.LILAC, FlowerPotInteraction::doublePlantInteraction);
+        map.put(Blocks.ROSE_BUSH, FlowerPotInteraction::doublePlantInteraction);
+        map.put(Blocks.PEONY, FlowerPotInteraction::doublePlantInteraction);
+        map.put(Blocks.PITCHER_PLANT, FlowerPotInteraction::doublePlantInteraction);
+        map.put(Blocks.BIG_DRIPLEAF, (level, pos, block) -> {
+            double size = pixel12;
+            return consumer(block.defaultBlockState().setValue(BlockStateProperties.TILT, Tilt.FULL), size)
+                    .andThen(blockDisplay -> {
+                        Vector3f translation = blockDisplay.getTranslation();
+                        blockDisplay.setTranslation(translation.set(translation.x(), translation.y(), (float) (pixel8 - pixel12 * size)));
+                    });
+        });
+        map.put(Blocks.SMALL_DRIPLEAF, FlowerPotInteraction::doublePlantInteraction);
+        map.put(Blocks.CHORUS_PLANT, (level, pos, block) -> consumer(block.defaultBlockState().setValue(ChorusPlantBlock.UP, true).setValue(ChorusPlantBlock.DOWN, true), pixel4 / pixel8, pixel12, pixel4 / pixel8));
+        map.put(Blocks.GLOW_LICHEN, FlowerPotInteraction::sphericalInteraction);
+        map.put(Blocks.HANGING_ROOTS, FlowerPotInteraction::hangingInteraction);
+        map.put(Blocks.WHEAT, FlowerPotInteraction::cropCircularInteraction);
+        map.put(Blocks.COCOA, (level, pos, block) -> {
+            double size = pixel4 / pixel8 + pixel1;
+            return consumer(block.defaultBlockState().setValue(CocoaBlock.AGE, CocoaBlock.MAX_AGE), size, size, size, pixel4 - pixel3 * size)
+                    .andThen(blockDisplay -> {
+                        Vector3f translation = blockDisplay.getTranslation();
+                        blockDisplay.setTranslation(translation.set(translation.x(), translation.y(), (float) (pixel8 - pixel5 * size)));
+                    });
+        });
+        map.put(Blocks.PUMPKIN_STEM, FlowerPotInteraction::cropInteraction);
+        map.put(Blocks.MELON_STEM, FlowerPotInteraction::cropInteraction);
+        map.put(Blocks.BEETROOTS, FlowerPotInteraction::cropCircularInteraction);
+        map.put(Blocks.TORCHFLOWER_CROP, FlowerPotInteraction::cropInteraction);
+        map.put(Blocks.PITCHER_CROP, (level, pos, block) -> consumer(block.defaultBlockState().setValue(PitcherCropBlock.AGE, 2), pixel4 / pixel10 + pixel1).andThen(consumerFlat()));
+        map.put(Blocks.CAVE_VINES, (level, pos, block) -> consumer(block.defaultBlockState().setValue(CaveVines.BERRIES, true)).andThen(consumerInvert()));
+        map.put(Blocks.SWEET_BERRY_BUSH, FlowerPotInteraction::cropInteraction);
+        map.put(Blocks.NETHER_WART, FlowerPotInteraction::cropCircularInteraction);
+        map.put(Blocks.LILY_PAD, FlowerPotInteraction::flatInteraction);
+        map.put(Blocks.SEAGRASS, (level, pos, block) -> consumer(block.defaultBlockState(), pixel8 - 1.0E-4, pixel10, pixel8 - 1.0E-4));
+        map.put(Blocks.SEA_PICKLE, (level, pos, block) -> consumer(block.defaultBlockState(), pixel16));
+        map.put(Blocks.KELP, (level, pos, block) -> consumer(block.defaultBlockState(), pixel12, pixel16, pixel12));
+        map.put(Blocks.TUBE_CORAL, FlowerPotInteraction::normalInteraction);
+        map.put(Blocks.BRAIN_CORAL, FlowerPotInteraction::normalInteraction);
+        map.put(Blocks.BUBBLE_CORAL, FlowerPotInteraction::normalInteraction);
+        map.put(Blocks.FIRE_CORAL, FlowerPotInteraction::normalInteraction);
+        map.put(Blocks.HORN_CORAL, FlowerPotInteraction::normalInteraction);
+        map.put(Blocks.DEAD_TUBE_CORAL, FlowerPotInteraction::normalInteraction);
+        map.put(Blocks.DEAD_BRAIN_CORAL, FlowerPotInteraction::normalInteraction);
+        map.put(Blocks.DEAD_BUBBLE_CORAL, FlowerPotInteraction::normalInteraction);
+        map.put(Blocks.DEAD_FIRE_CORAL, FlowerPotInteraction::normalInteraction);
+        map.put(Blocks.DEAD_HORN_CORAL, FlowerPotInteraction::normalInteraction);
+        map.put(Blocks.TUBE_CORAL_FAN, FlowerPotInteraction::flatInteraction);
+        map.put(Blocks.BRAIN_CORAL_FAN, FlowerPotInteraction::flatInteraction);
+        map.put(Blocks.BUBBLE_CORAL_FAN, FlowerPotInteraction::flatInteraction);
+        map.put(Blocks.FIRE_CORAL_FAN, FlowerPotInteraction::flatInteraction);
+        map.put(Blocks.HORN_CORAL_FAN, FlowerPotInteraction::flatInteraction);
+        map.put(Blocks.DEAD_TUBE_CORAL_FAN, FlowerPotInteraction::flatInteraction);
+        map.put(Blocks.DEAD_BRAIN_CORAL_FAN, FlowerPotInteraction::flatInteraction);
+        map.put(Blocks.DEAD_BUBBLE_CORAL_FAN, FlowerPotInteraction::flatInteraction);
+        map.put(Blocks.DEAD_FIRE_CORAL_FAN, FlowerPotInteraction::flatInteraction);
+        map.put(Blocks.DEAD_HORN_CORAL_FAN, FlowerPotInteraction::flatInteraction);
+        map.put(Blocks.SCULK_VEIN, FlowerPotInteraction::sphericalInteraction);
+        map.put(Blocks.CARROTS, FlowerPotInteraction::cropCircularInteraction);
+        map.put(Blocks.POTATOES, FlowerPotInteraction::cropCircularInteraction);
+        map.put(Blocks.CAKE, (level, pos, block) -> {
+            double size = pixel6 / pixel14 - pixel1;
+            return consumer(block.defaultBlockState(), size, size, size, pixel6 - pixel8 * size + (pixel1 / 2));
+        });
+    }
+
+    private static Consumer<Display.BlockDisplay> normalInteraction(Level level, BlockPos pos, Block block) {
+        return consumer(block.defaultBlockState());
+    }
+
+    private static Consumer<Display.BlockDisplay> hangingInteraction(Level level, BlockPos pos, Block block) {
+        return normalInteraction(level, pos, block).andThen(consumerInvert());
+    }
+
+    private static Consumer<Display.BlockDisplay> flatInteraction(Level level, BlockPos pos, Block block) {
+        return normalInteraction(level, pos, block).andThen(consumerFlat());
+    }
+
+    private static Consumer<Display.BlockDisplay> sphericalInteraction(Level level, BlockPos pos, Block block) {
+        return consumer(block.defaultBlockState(), pixel8);
+    }
+
+    private static Consumer<Display.BlockDisplay> doublePlantInteraction(Level level, BlockPos pos, Block block) {
+        BlockState blockState = block.defaultBlockState();
+        if (blockState.hasProperty(DoublePlantBlock.HALF)) {
+            return consumer(blockState.setValue(DoublePlantBlock.HALF, DoubleBlockHalf.UPPER));
+        }
+        throw new IllegalStateException("方块" + BuiltInRegistries.BLOCK.wrapAsHolder(block).getRegisteredName() + "没有HALF属性");
+    }
+
+    private static Consumer<Display.BlockDisplay> cropInteraction(Level level, BlockPos pos, Block block) {
+        return ageInteraction(block, pixel12, pixel12, pixel12);
+    }
+
+    private static Consumer<Display.BlockDisplay> cropCircularInteraction(Level level, BlockPos pos, Block block) {
+        return ageInteraction(block, pixel8 - 1.0E-4, pixel8 + pixel1, pixel8 - 1.0E-4).andThen(consumerFlat());
+    }
+
+    private static Consumer<Display.BlockDisplay> ageInteraction(Block block, double xsize, double ysize, double zsize) {
+        BlockState blockState = block.defaultBlockState();
+        for (Property<?> property : blockState.getProperties()) {
+            if (property instanceof IntegerProperty integerProperty && "age".equals(property.getName())) {
+                return consumer(blockState.setValue(integerProperty, integerProperty.max), xsize, ysize, zsize);
+            }
+        }
+        throw new IllegalStateException("方块" + BuiltInRegistries.BLOCK.wrapAsHolder(block).getRegisteredName() + "没有AGE属性");
+    }
+
+    static @Nullable Consumer<Display.BlockDisplay> defaultInteraction(Level level, BlockPos pos, Block block) {
+        BlockState blockState = block.defaultBlockState();
+        if (blockState.is(BlockTags.WALLS)) {
+            return consumer(blockState, pixel4 / pixel8, pixel12, pixel4 / pixel8);
+        } else if (blockState.is(BlockTags.CANDLES)) {
+            return consumer(blockState.setValue(CandleBlock.LIT, true), pixel16);
+        }
+
+        if (blockState.hasProperty(HorizontalDirectionalBlock.FACING)) {
+            return null;
+        }
+
+        VoxelShape voxelShape = blockState.getShape(level, pos);
+        if (voxelShape.isEmpty()) {
+            return null;
+        }
+
+        AABB bounds = voxelShape.bounds();
+        if (bounds.minY != 0) {
+            return null;
+        }
+
+        double xsize = bounds.getXsize();
+        double ysize = bounds.getYsize();
+        double zsize = bounds.getZsize();
+        if (xsize <= pixel4 && zsize <= pixel4 && ysize >= pixel4 && ysize <= pixel12) {
+            return consumer(blockState, 1.0);
+        } else if (xsize <= pixel6 && zsize <= pixel6 && ysize >= pixel6) {
+            return consumer(blockState);
+        } else {
+            return null;
+        }
+    }
+
+    private static Consumer<Display.BlockDisplay> consumer(BlockState blockState) {
+        return consumer(blockState, pixel12);
+    }
+
+    private static Consumer<Display.BlockDisplay> consumer(BlockState blockState, double size) {
+        return consumer(blockState, size, size, size);
+    }
+
+    private static Consumer<Display.BlockDisplay> consumer(BlockState blockState, double xsize, double ysize, double zsize) {
+        return consumer(blockState, xsize, ysize, zsize, pixel4);
+    }
+
+    private static Consumer<Display.BlockDisplay> consumer(BlockState blockState, double xsize, double ysize, double zsize, double floorY) {
+        return blockDisplay -> {
+            blockDisplay.setScaleCenterFloor(xsize, ysize, zsize, floorY);
+            blockDisplay.setBlockState(blockState);
+        };
+    }
+
+    private static Consumer<Display.BlockDisplay> consumerInvert() {
+        return Display::setInvert;
+    }
+
+    private static Consumer<Display.BlockDisplay> consumerFlat() {
+        return display -> display.setTranslation(display.getTranslation().add(0.0F, (float) pixel2, 0.0F));
+    }
+}
+// KioCG end - custom block entity: all class
