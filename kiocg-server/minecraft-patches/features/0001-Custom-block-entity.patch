@@ -0,0 +1,89 @@
+package net.minecraft.world.level.block.entity;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.HolderLookup;
+import net.minecraft.core.particles.ParticleTypes;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.sounds.SoundEvents;
+import net.minecraft.sounds.SoundSource;
+import net.minecraft.tags.BlockTags;
+import net.minecraft.world.level.block.Blocks;
+import net.minecraft.world.level.block.CampfireBlock;
+import net.minecraft.world.level.block.LayeredCauldronBlock;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.level.gameevent.GameEvent;
+
+// KioCG start - custom block entity: all class
+public class CauldronBlockEntity extends BlockEntity {
+    private int temperature = 0;
+
+    public CauldronBlockEntity(BlockPos pos, BlockState blockState) {
+        super(BlockEntityType.CAULDRON, pos, blockState);
+    }
+
+    public static void serverTickLayered(ServerLevel level, BlockPos pos, BlockState state, CauldronBlockEntity cauldron) {
+        boolean flag = false;
+
+        BlockState belowState = level.getBlockState(pos.below());
+        if (belowState.is(BlockTags.CAMPFIRES, blockStateBase -> blockStateBase.getValueOrElse(CampfireBlock.LIT, false)) || belowState.is(Blocks.FIRE) || belowState.is(Blocks.LAVA)) {
+            if (!cauldron.isBoiling()) {
+                int per = LayeredCauldronBlock.MAX_FILL_LEVEL - state.getValue(LayeredCauldronBlock.LEVEL) + 1;
+                cauldron.temperature = Math.min(cauldron.temperature + per, level.paperConfig().kiocgConfig.theLongDark.campfireBoilingWaterTime);
+
+                if (cauldron.isBoiling() && state.is(Blocks.POWDER_SNOW_CAULDRON)) {
+                    if (LayeredCauldronBlock.changeLevel(level, pos, Blocks.WATER_CAULDRON.defaultBlockState(), null, org.bukkit.event.block.CauldronLevelChangeEvent.ChangeReason.EVAPORATE, false)) { // avoid duplicate game event
+                        level.setBlockAndUpdate(pos, Blocks.WATER_CAULDRON.defaultBlockState());
+                        level.gameEvent(null, GameEvent.BLOCK_CHANGE, pos);
+                        return;
+                    }
+                }
+
+                flag = true;
+            } else {
+                if (level.getGameTime() % 4 == 0 && level.getRandom().nextFloat() < 0.25F) {
+                    level.playSound(null, pos, SoundEvents.POINTED_DRIPSTONE_DRIP_WATER_INTO_CAULDRON, SoundSource.BLOCKS, 1.0F, 0.1F);
+                }
+
+                double x = (double) pos.getX() + 0.5;
+                double y = (double) pos.getY() + 1.0;
+                double z = (double) pos.getZ() + 0.5;
+                level.sendParticles(ParticleTypes.FALLING_WATER, x, y, z, 10, 0.25, 0.1, 0.25, 1.0);
+            }
+        } else if (cauldron.temperature > 0) {
+            int per = LayeredCauldronBlock.MAX_FILL_LEVEL - state.getValue(LayeredCauldronBlock.LEVEL) + 1;
+            cauldron.temperature = Math.max(cauldron.temperature - per, 0);
+            flag = true;
+        }
+
+        if (flag) {
+            setChanged(level, pos, state);
+        }
+    }
+
+    public boolean isBoiling() {
+        return this.temperature >= this.level.paperConfig().kiocgConfig.theLongDark.campfireBoilingWaterTime;
+    }
+
+    public void setTemperature(int temperature) {
+        this.temperature = temperature;
+        this.setChanged();
+    }
+
+    public void levelChanged(int oldLevel, int newLevel) {
+        if (newLevel > oldLevel) {
+            setTemperature(this.temperature * oldLevel / newLevel);
+        }
+    }
+
+    @Override
+    protected void loadAdditional(CompoundTag tag, HolderLookup.Provider registries) {
+        this.temperature = tag.getInt("KioCG.Temperature");
+    }
+
+    @Override
+    protected void saveAdditional(CompoundTag tag, HolderLookup.Provider registries) {
+        tag.putInt("KioCG.Temperature", this.temperature);
+    }
+}
+// KioCG end - custom block entity: all class
