@@ -181,6 +181,39 @@ public abstract class Display extends Entity {
         }
     }
 
+    // KioCG start - custom block entity
+    @Nullable
+    public static <T extends Display> T getCustomDisplay(EntityType<T> entityType, ServerLevel level, net.minecraft.core.BlockPos pos) {
+        List<T> list = com.google.common.collect.Lists.newArrayList();
+        double x = pos.getX() + 0.5, y = pos.getY() + 0.5, z = pos.getZ() + 0.5;
+        level.getEntities(entityType, new AABB(x, y, z, x, y, z).inflate(1.0E-5), display -> {
+            return !display.persist;
+        }, list, 1);
+        return !list.isEmpty() ? list.getFirst() : null;
+    }
+
+    public static <T extends Display> void createCustomDisplay(EntityType<T> entityType, ServerLevel level, net.minecraft.core.BlockPos pos, java.util.function.Consumer<T> consumer) {
+        T display = entityType.create(level, EntitySpawnReason.COMMAND);
+        if (display != null) {
+            display.snapTo(pos.getX() + 0.5, pos.getY() + 0.5, pos.getZ() + 0.5, 0.0F, 0.0F);
+            // 将方块展示实体居中
+            if (display instanceof BlockDisplay) {
+                display.setTranslation(new Vector3f(-0.5F, -0.5F, -0.5F));
+            }
+            display.persist = false;
+            consumer.accept(display);
+            level.addFreshEntity(display, org.bukkit.event.entity.CreatureSpawnEvent.SpawnReason.CUSTOM);
+        }
+    }
+
+    public static <T extends Display> void discardCustomDisplay(EntityType<T> entityType, ServerLevel level, net.minecraft.core.BlockPos pos) {
+        T customDisplay = getCustomDisplay(entityType, level, pos);
+        if (customDisplay != null) {
+            customDisplay.discard();
+        }
+    }
+    // KioCG end - custom block entity
+
     @Override
