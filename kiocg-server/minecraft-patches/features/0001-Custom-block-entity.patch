+
+// KioCG start - custom block entity: all class
+public class FlowerPotBlockEntity extends BlockEntity {
+    private Block potted = Blocks.AIR;
+    private BlockState pottedState = potted.defaultBlockState();
+    private PottedTick pottedTick = PottedTick.NONE;
+    private Direction facing = Direction.SOUTH;
+    private boolean firstTick;
+
+    public FlowerPotBlockEntity(BlockPos pos, BlockState blockState) {
+        super(BlockEntityType.FLOWER_POT, pos, blockState);
+    }
+
+    public static void serverTick(ServerLevel level, BlockPos pos, BlockState state, FlowerPotBlockEntity flowerPot) {
+        if (!flowerPot.firstTick) {
+            flowerPot.firstTick = true;
+            flowerPot.refreshDisplayBlock(level, pos);
+        }
+
+        if (flowerPot.pottedTick != PottedTick.NONE) {
+            flowerPot.pottedTick.tick(level, pos, state, flowerPot);
+        } else {
+            level.getChunkAt(pos).removeBlockEntityTicker(pos);
+        }
+    }
+
+    public Block getPotted() {
+        return this.potted;
+    }
+
+    public BlockState getPottedState() {
+        return this.pottedState;
+    }
+
+    public Block getPottedAndRemove() {
+        Block temp = this.potted;
+        this.setPotted(Blocks.AIR, Blocks.AIR.defaultBlockState(), Direction.SOUTH);
+        return temp;
+    }
+
+    public boolean isEmpty() {
+        return this.potted == Blocks.AIR;
+    }
+
+    public void updatePottedState(BlockState pottedState) {
+        setPotted(this.potted, pottedState, this.facing);
+    }
+
+    public void setPotted(Block potted, BlockState pottedState, Direction facing) {
+        this.potted = potted;
+        this.pottedState = pottedState;
+        this.pottedTick = PottedTick.pottedTick(this);
+        this.facing = facing;
+        if (this.hasLevel()) {
+            this.refreshDisplayBlock((ServerLevel) this.getLevel(), this.getBlockPos());
+            if (this.pottedTick != PottedTick.NONE) {
+                this.getLevel().getChunkAt(this.getBlockPos()).updateBlockEntityTicker(this);
+            }
+        }
+    }
+
+    private void refreshDisplayBlock(ServerLevel level, BlockPos pos) {
+        if (this.isEmpty()) {
+            Display.BlockDisplay.discardDisplayBlock(level, pos);
+            return;
+        }
+
+        Optional<Consumer<Display.BlockDisplay>> optional = FlowerPotInteraction.getInteract(level, pos, this.getPotted(), this.getPottedState());
+        optional.ifPresent(consumer -> {
+            consumer = consumer.andThen(display -> display.setYRot(facing.toYRot()));
+            Display.BlockDisplay displayBlock = Display.BlockDisplay.getDisplayBlock(level, pos);
+            if (displayBlock != null) {
+                consumer.accept(displayBlock);
+            } else {
+                Display.BlockDisplay.createDisplayBlock(level, pos, consumer);
+            }
+        });
+    }
+
+    @Override
+    protected void loadAdditional(CompoundTag tag, HolderLookup.Provider registries) {
+        if (tag.contains("KioCG.Potted")) {
+            ResourceLocation resourceLocation = ResourceLocation.tryParse(tag.getString("KioCG.Potted"));
+            Block potted = BuiltInRegistries.BLOCK.getValue(resourceLocation);
+            HolderGetter<Block> holderGetter = this.level != null ? this.level.holderLookup(Registries.BLOCK) : BuiltInRegistries.BLOCK;
+            BlockState pottedState = NbtUtils.readBlockState(holderGetter, tag.getCompound("KioCG.PottedState"));
+            Direction facing = Direction.byName(tag.getString("KioCG.Facing"));
+            this.setPotted(potted, pottedState, Objects.requireNonNullElse(facing, Direction.SOUTH));
+        }
+    }
+
+    @Override
+    protected void saveAdditional(CompoundTag tag, HolderLookup.Provider registries) {
+        if (!this.isEmpty()) {
+            tag.putString("KioCG.Potted", BuiltInRegistries.BLOCK.getKey(this.getPotted()).toString());
+            tag.put("KioCG.PottedState", NbtUtils.writeBlockState(this.getPottedState()));
+            tag.putString("KioCG.Facing", this.facing.getName());
+        }
+    }
+
+    private interface PottedTick {
+        PottedTick NONE = (level, pos, state, flowerPot) -> {
+        };
+
