diff --git a/net/minecraft/world/entity/Display.java b/net/minecraft/world/entity/Display.java
index 91e9ed6a11c97d1b0482f870078fa355c5ce01d8..698965c983de4c7ab05d0c1807e604e5994e2a58 100644
