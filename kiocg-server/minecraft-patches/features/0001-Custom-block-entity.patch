@@ -0,0 +1,136 @@
+package net.minecraft.world.level.block.entity;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.HolderLookup;
+import net.minecraft.core.flowerpot.FlowerPotInteraction;
+import net.minecraft.core.particles.ParticleTypes;
+import net.minecraft.core.registries.BuiltInRegistries;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.resources.ResourceLocation;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.tags.BlockTags;
+import net.minecraft.world.entity.Display;
+import net.minecraft.world.level.block.AbstractCandleBlock;
+import net.minecraft.world.level.block.Block;
+import net.minecraft.world.level.block.Blocks;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.phys.Vec3;
+
+import java.util.Optional;
+import java.util.function.Consumer;
+
+// KioCG start - custom block entity: all class
+public class FlowerPotBlockEntity extends BlockEntity {
+    private Block potted = Blocks.AIR;
+    private PottedTick pottedTick = PottedTick.NONE;
+    private boolean firstTick;
+
+    public FlowerPotBlockEntity(BlockPos pos, BlockState blockState) {
+        super(BlockEntityType.FLOWER_POT, pos, blockState);
+    }
+
+    public static void serverTick(ServerLevel level, BlockPos pos, BlockState state, FlowerPotBlockEntity flowerPot) {
+        if (!flowerPot.firstTick) {
+            flowerPot.firstTick = true;
+            flowerPot.refreshDisplayBlock(level, pos);
+        }
+
+        if (flowerPot.pottedTick != PottedTick.NONE) {
+            flowerPot.pottedTick.tick(level, pos, state, flowerPot);
+        } else {
+            level.getChunkAt(pos).removeBlockEntityTicker(pos);
+        }
+    }
+
+    public Block getPotted() {
+        return this.potted;
+    }
+
+    public Block getPottedAndRemove() {
+        Block temp = this.potted;
+        this.setPotted(Blocks.AIR);
+        return temp;
+    }
+
+    public boolean isEmpty() {
+        return this.potted == Blocks.AIR;
+    }
+
+    public void setPotted(Block potted) {
+        if (this.potted != potted) {
+            this.potted = potted;
+            this.pottedTick = PottedTick.pottedTick(this);
+
+            if (this.hasLevel()) {
+                this.refreshDisplayBlock((ServerLevel) this.getLevel(), this.getBlockPos());
+                if (this.pottedTick != PottedTick.NONE) {
+                    this.getLevel().getChunkAt(this.getBlockPos()).updateBlockEntityTicker(this);
+                }
+            }
+        }
+    }
+
+    private void refreshDisplayBlock(ServerLevel level, BlockPos pos) {
+        Display.BlockDisplay.removeDisplayBlock(level, pos);
+        if (!this.isEmpty()) {
+            Optional<Consumer<Display.BlockDisplay>> optional = FlowerPotInteraction.get(level, pos, this.getPotted());
+            optional.ifPresent(consumer -> Display.BlockDisplay.setDisplayBlock(level, pos, consumer));
+        }
+    }
+
+    @Override
+    protected void loadAdditional(CompoundTag tag, HolderLookup.Provider registries) {
+        if (tag.contains("KioCG.Item")) {
+            ResourceLocation resourceLocation = ResourceLocation.tryParse(tag.getString("KioCG.Item"));
+            this.setPotted(BuiltInRegistries.BLOCK.getValue(resourceLocation));
+        }
+    }
+
+    @Override
+    protected void saveAdditional(CompoundTag tag, HolderLookup.Provider registries) {
+        if (!this.isEmpty()) {
+            tag.putString("KioCG.Item", BuiltInRegistries.BLOCK.getKey(this.getPotted()).toString());
+        }
+    }
+
+    private interface PottedTick {
+        PottedTick NONE = (level, pos, state, flowerPot) -> {
+        };
+
+        void tick(ServerLevel level, BlockPos pos, BlockState state, FlowerPotBlockEntity flowerPot);
+
+        private static PottedTick pottedTick(FlowerPotBlockEntity flowerPot) {
+            if (!flowerPot.isEmpty()) {
+                BlockState pottedState = flowerPot.getPotted().defaultBlockState();
+                if (pottedState.is(BlockTags.CANDLES)) {
+                    return PottedTick::candleTick;
+                } else if (pottedState.is(Blocks.SPORE_BLOSSOM)) {
+                    return PottedTick::sporeBlossomTick;
+                }
+            }
+            return NONE;
+        }
+
+        private static void candleTick(ServerLevel level, BlockPos pos, BlockState state, FlowerPotBlockEntity flowerPot) {
+            if (level.random.nextFloat() < (float) (1.0 / 8.0)) {
+                AbstractCandleBlock.addParticlesAndSound(level, new Vec3(pos.getX() + 0.5, pos.getY() + 0.5 + 0.25, pos.getZ() + 0.5), level.random);
+            }
+        }
+
+        private static void sporeBlossomTick(ServerLevel level, BlockPos pos, BlockState state, FlowerPotBlockEntity flowerPot) {
+            if (level.random.nextFloat() < (float) (1.0 / 20.0)) {
+                level.sendParticles(
+                        ParticleTypes.SPORE_BLOSSOM_AIR,
+                        pos.getX() + 0.5,
+                        pos.getY() + 1.0,
+                        pos.getZ() + 0.5,
+                        2,
+                        0.5,
+                        0.5,
+                        0.5,
+                        0.0);
+            }
+        }
+    }
+}
+// KioCG end - custom block entity: all class
