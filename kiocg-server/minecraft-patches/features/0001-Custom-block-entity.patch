@@ -674,6 +674,35 @@ public abstract class Display extends Entity {
 
         public record BlockRenderState(BlockState blockState) {
         }
+
+        // KioCG start - custom block entity
+        @Nullable
+        public static Display.BlockDisplay getDisplayBlock(ServerLevel level, net.minecraft.core.BlockPos pos) {
+            double x = pos.getX() + 0.5, y = pos.getY() + 0.5, z = pos.getZ() + 0.5;
+            List<Display.BlockDisplay> entitiesOfClass = level.getEntitiesOfClass(Display.BlockDisplay.class, new AABB(x, y, z, x, y, z).inflate(1.0E-5), display -> {
+                return !display.persist;
+            });
+            return !entitiesOfClass.isEmpty() ? entitiesOfClass.getFirst() : null;
+        }
+
+        public static void createDisplayBlock(ServerLevel level, net.minecraft.core.BlockPos pos, java.util.function.Consumer<BlockDisplay> consumer) {
+            Display.BlockDisplay display = EntityType.BLOCK_DISPLAY.create(level, EntitySpawnReason.COMMAND);
+            if (display != null) {
+                display.moveTo(pos.getX() + 0.5, pos.getY() + 0.5, pos.getZ() + 0.5, 0.0F, 0.0F);
+                display.setTranslation(new Vector3f(-0.5F, -0.5F, -0.5F));
+                display.persist = false;
+                consumer.accept(display);
+                level.addFreshEntity(display, org.bukkit.event.entity.CreatureSpawnEvent.SpawnReason.CUSTOM);
+            }
+        }
+
+        public static void discardDisplayBlock(ServerLevel level, net.minecraft.core.BlockPos pos) {
+            Display.BlockDisplay displayBlock = getDisplayBlock(level, pos);
+            if (displayBlock != null) {
+                displayBlock.discard();
+            }
+        }
+        // KioCG end - custom block entity
     }
 
