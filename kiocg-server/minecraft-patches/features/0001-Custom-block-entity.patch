+package net.minecraft.core.flowerpot;
+
+import it.unimi.dsi.fastutil.objects.Object2ObjectOpenHashMap;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.Direction;
+import net.minecraft.tags.BlockTags;
+import net.minecraft.util.RandomSource;
+import net.minecraft.world.entity.Display;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.level.block.*;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.level.block.state.properties.BlockStateProperties;
+import net.minecraft.world.level.block.state.properties.BooleanProperty;
+import net.minecraft.world.level.block.state.properties.DoubleBlockHalf;
+import net.minecraft.world.level.block.state.properties.Property;
+import net.minecraft.world.phys.AABB;
+import net.minecraft.world.phys.shapes.VoxelShape;
+import org.jetbrains.annotations.Nullable;
+
+import java.util.List;
+import java.util.Optional;
+import java.util.function.Consumer;
+import java.util.function.Function;
+
+// KioCG start - custom block entity: all class
+public interface FlowerPotInteraction {
+    RandomSource RANDOM = RandomSource.create();
+    double pixel1 = 1.0 / 16.0, pixel2 = 2.0 / 16.0, pixel3 = 3.0 / 16.0, pixel4 = 4.0 / 16.0;
+    double pixel5 = 5.0 / 16.0, pixel6 = 6.0 / 16.0, pixel7 = 7.0 / 16.0, pixel8 = 8.0 / 16.0;
+    double pixel9 = 9.0 / 16.0, pixel10 = 10.0 / 16.0, pixel11 = 11.0 / 16.0, pixel12 = 12.0 / 16.0;
+    double pixel13 = 13.0 / 16.0, pixel14 = 14.0 / 16.0, pixel15 = 15.0 / 16.0, pixel16 = 16.0 / 16.0;
+
+    @Nullable Consumer<Display.BlockDisplay> interact(Level level, BlockPos pos, BlockState blockState);
+
+    Object2ObjectOpenHashMap<Block, Data> map = new Object2ObjectOpenHashMap<>();
+
+    static Optional<BlockState> getBlockState(Level level, BlockPos pos, Block block) {
+        Data data = FlowerPotInteraction.map.get(block);
+        BlockState blockState = data.blockStateGenerator().apply(block);
+        return Optional.ofNullable(data.interaction().interact(level, pos, blockState)).map(consumer -> blockState);
+    }
+
+    static Optional<Consumer<Display.BlockDisplay>> getInteract(Level level, BlockPos pos, Block potted, BlockState pottedState) {
+        Data data = FlowerPotInteraction.map.get(potted);
+        return Optional.ofNullable(data.interaction().interact(level, pos, pottedState));
+    }
+
+    static void bootStrap() {
+        map.defaultReturnValue(Data.get(FlowerPotInteraction::defaultInteraction));
+        map.put(Blocks.PALE_HANGING_MOSS, Data.get((level, pos, state) -> {
+            if (state.getValue(HangingMossBlock.TIP)) {
+                return FlowerPotInteraction.hangingInteraction(level, pos, state);
+            } else {
+                return FlowerPotInteraction.normalInteraction(level, pos, state);
+            }
+        }).randomProperty(HangingMossBlock.TIP));
+        map.put(Blocks.SMALL_AMETHYST_BUD, Data.get((level, pos, state) -> consumer(state, 0.65)));
+        map.put(Blocks.MEDIUM_AMETHYST_BUD, Data.get((level, pos, state) -> consumer(state, 0.65)));
+        map.put(Blocks.LARGE_AMETHYST_BUD, Data.get(FlowerPotInteraction::normalInteraction));
+        map.put(Blocks.AMETHYST_CLUSTER, Data.get(FlowerPotInteraction::normalInteraction));
+        map.put(Blocks.SHORT_GRASS, Data.get(FlowerPotInteraction::normalInteraction));
+        map.put(Blocks.PINK_PETALS, Data.get((level, pos, state) -> {
+            double size = 0.7;
+            return consumer(state, size, 1.0, size)
+                    .andThen(blockDisplay -> {
+                        blockDisplay.setTranslation(blockDisplay.getTranslation().add((float) (pixel4 * size), 0.0F, (float) (pixel4 * size)));
+                    });
+        }));
+        map.put(Blocks.SPORE_BLOSSOM, Data.get((level, pos, state) -> consumer(state, pixel6 / pixel12).andThen(consumerInvert()).andThen(consumerFlat())));
+        map.put(Blocks.SUGAR_CANE, Data.get((level, pos, state) -> consumer(state, 0.45, pixel12, 0.45)));
+        map.put(Blocks.NETHER_SPROUTS, Data.get((level, pos, state) -> consumer(state, 0.45)));
+        map.put(Blocks.WEEPING_VINES, Data.get(FlowerPotInteraction::hangingInteraction, Blocks.WEEPING_VINES_PLANT));
+        map.put(Blocks.TWISTING_VINES, Data.get(FlowerPotInteraction::normalInteraction, Blocks.TWISTING_VINES_PLANT));
+        map.put(Blocks.VINE, Data.get(FlowerPotInteraction::sphericalInteraction));
+
+        Data doublePlantData = Data.get(FlowerPotInteraction::normalInteraction).randomProperty(DoublePlantBlock.HALF);
+        Data doublePlantLowerInvertData = Data.get((level, pos, state) -> {
+            if (state.getValue(DoublePlantBlock.HALF) == DoubleBlockHalf.UPPER) {
+                return FlowerPotInteraction.normalInteraction(level, pos, state);
+            } else {
+                return FlowerPotInteraction.hangingInteraction(level, pos, state);
+            }
+        }).randomProperty(DoublePlantBlock.HALF);
+        map.put(Blocks.TALL_GRASS, doublePlantData);
+        map.put(Blocks.LARGE_FERN, doublePlantLowerInvertData);
+        map.put(Blocks.SUNFLOWER, doublePlantData);
+        map.put(Blocks.LILAC, doublePlantData);
+        map.put(Blocks.ROSE_BUSH, doublePlantData);
+        map.put(Blocks.PEONY, doublePlantLowerInvertData);
+        map.put(Blocks.PITCHER_PLANT, Data.get((level, pos, state) -> {
+            double size = pixel12;
+            if (state.getValue(DoublePlantBlock.HALF) == DoubleBlockHalf.UPPER) {
+                return consumer(state, size, size, size, pixel4 + pixel5 * size);
+            } else {
+                return consumer(state, size, size, size, pixel4 - pixel5 * size).andThen(consumerInvert());
+            }
+        }).randomProperty(DoublePlantBlock.HALF));
+        map.put(Blocks.BIG_DRIPLEAF, Data.get((level, pos, state) -> {
+            double size = pixel12;
+            return consumer(state, size)
+                    .andThen(blockDisplay -> {
+                        Direction facing = state.getValue(BigDripleafBlock.FACING);
+                        blockDisplay.setTranslation(blockDisplay.getTranslation().add((float) (facing.getStepX() * (pixel4 * size)), 0.0F, (float) (facing.getStepZ() * (pixel4 * size))));
+                    });
+        }).randomProperty(BlockStateProperties.TILT));
+        map.put(Blocks.SMALL_DRIPLEAF, doublePlantData);
+        map.put(Blocks.CHORUS_PLANT, Data.get((level, pos, state) -> {
+            // 每次加载都随机样式
+            state = state.setValue(ChorusPlantBlock.NORTH, RANDOM.nextBoolean())
+                         .setValue(ChorusPlantBlock.EAST, RANDOM.nextBoolean())
+                         .setValue(ChorusPlantBlock.SOUTH, RANDOM.nextBoolean())
+                         .setValue(ChorusPlantBlock.WEST, RANDOM.nextBoolean())
+                         .setValue(ChorusPlantBlock.UP, RANDOM.nextBoolean());
+            return consumer(state, pixel4 / pixel8, pixel12, pixel4 / pixel8);
+        }, state -> state.setValue(ChorusPlantBlock.UP, true).setValue(ChorusPlantBlock.DOWN, true)));
+        map.put(Blocks.GLOW_LICHEN, Data.get(FlowerPotInteraction::sphericalInteraction));
+        map.put(Blocks.HANGING_ROOTS, Data.get(FlowerPotInteraction::hangingInteraction));
+        map.put(Blocks.WHEAT, Data.get(FlowerPotInteraction::cropCircularInteraction).randomProperty(CropBlock.AGE));
+        map.put(Blocks.COCOA, Data.get((level, pos, state) -> {
+            double size = pixel4 / pixel8 + pixel1;
+            return consumer(state, size, size, size, pixel4 - pixel3 * size)
+                    .andThen(blockDisplay -> {
+                        Direction facing = state.getValue(BigDripleafBlock.FACING);
+                        blockDisplay.setTranslation(blockDisplay.getTranslation().add((float) -(facing.getStepX() * (pixel3 * size)), 0.0F, (float) -(facing.getStepZ() * (pixel3 * size))));
+                    });
+        }, state -> state.setValue(CocoaBlock.AGE, CocoaBlock.MAX_AGE)));
+        map.put(Blocks.PUMPKIN_STEM, Data.get(FlowerPotInteraction::cropInteraction, state -> state.setValue(StemBlock.AGE, RANDOM.nextInt(1, StemBlock.MAX_AGE))));
+        map.put(Blocks.MELON_STEM, Data.get(FlowerPotInteraction::cropInteraction, state -> state.setValue(StemBlock.AGE, RANDOM.nextInt(1, StemBlock.MAX_AGE))));
+        map.put(Blocks.BEETROOTS, Data.get(FlowerPotInteraction::cropCircularInteraction).randomProperty(BeetrootBlock.AGE));
+        map.put(Blocks.TORCHFLOWER_CROP, Data.get(FlowerPotInteraction::cropInteraction).randomProperty(TorchflowerCropBlock.AGE));
+        map.put(Blocks.PITCHER_CROP, Data.get((level, pos, state) -> consumer(state, pixel4 / pixel10 + pixel1).andThen(consumerFlat()), state -> state.setValue(PitcherCropBlock.AGE, RANDOM.nextInt(1, 3))));
+        map.put(Blocks.CAVE_VINES, Data.get(FlowerPotInteraction::hangingInteraction).randomProperty(CaveVines.BERRIES));
+        map.put(Blocks.SWEET_BERRY_BUSH, Data.get(FlowerPotInteraction::cropInteraction).randomProperty(SweetBerryBushBlock.AGE));
+        map.put(Blocks.NETHER_WART, Data.get(FlowerPotInteraction::cropCircularInteraction).randomProperty(NetherWartBlock.AGE));
+        map.put(Blocks.LILY_PAD, Data.get(FlowerPotInteraction::flatInteraction));
+        map.put(Blocks.SEAGRASS, Data.get((level, pos, state) -> consumer(state, pixel8 - 1.0E-4, pixel10, pixel8 - 1.0E-4)));
+        map.put(Blocks.SEA_PICKLE, Data.get(FlowerPotInteraction::originalInteraction).randomProperty(SeaPickleBlock.WATERLOGGED));
+        map.put(Blocks.KELP, Data.get((level, pos, state) -> consumer(state, pixel12, pixel16, pixel12)));
+        map.put(Blocks.TUBE_CORAL, Data.get(FlowerPotInteraction::normalInteraction));
+        map.put(Blocks.BRAIN_CORAL, Data.get(FlowerPotInteraction::normalInteraction));
+        map.put(Blocks.BUBBLE_CORAL, Data.get(FlowerPotInteraction::normalInteraction));
+        map.put(Blocks.FIRE_CORAL, Data.get(FlowerPotInteraction::normalInteraction));
+        map.put(Blocks.HORN_CORAL, Data.get(FlowerPotInteraction::normalInteraction));
+        map.put(Blocks.DEAD_TUBE_CORAL, Data.get(FlowerPotInteraction::normalInteraction));
+        map.put(Blocks.DEAD_BRAIN_CORAL, Data.get(FlowerPotInteraction::normalInteraction));
+        map.put(Blocks.DEAD_BUBBLE_CORAL, Data.get(FlowerPotInteraction::normalInteraction));
+        map.put(Blocks.DEAD_FIRE_CORAL, Data.get(FlowerPotInteraction::normalInteraction));
+        map.put(Blocks.DEAD_HORN_CORAL, Data.get(FlowerPotInteraction::normalInteraction));
+        map.put(Blocks.TUBE_CORAL_FAN, Data.get(FlowerPotInteraction::flatInteraction));
+        map.put(Blocks.BRAIN_CORAL_FAN, Data.get(FlowerPotInteraction::flatInteraction));
+        map.put(Blocks.BUBBLE_CORAL_FAN, Data.get(FlowerPotInteraction::flatInteraction));
+        map.put(Blocks.FIRE_CORAL_FAN, Data.get(FlowerPotInteraction::flatInteraction));
+        map.put(Blocks.HORN_CORAL_FAN, Data.get(FlowerPotInteraction::flatInteraction));
+        map.put(Blocks.DEAD_TUBE_CORAL_FAN, Data.get(FlowerPotInteraction::flatInteraction));
+        map.put(Blocks.DEAD_BRAIN_CORAL_FAN, Data.get(FlowerPotInteraction::flatInteraction));
+        map.put(Blocks.DEAD_BUBBLE_CORAL_FAN, Data.get(FlowerPotInteraction::flatInteraction));
+        map.put(Blocks.DEAD_FIRE_CORAL_FAN, Data.get(FlowerPotInteraction::flatInteraction));
+        map.put(Blocks.DEAD_HORN_CORAL_FAN, Data.get(FlowerPotInteraction::flatInteraction));
+        map.put(Blocks.SCULK_VEIN, Data.get(FlowerPotInteraction::sphericalInteraction));
+        map.put(Blocks.CARROTS, Data.get(FlowerPotInteraction::cropCircularInteraction).randomProperty(CarrotBlock.AGE));
+        map.put(Blocks.POTATOES, Data.get(FlowerPotInteraction::cropCircularInteraction).randomProperty(PotatoBlock.AGE));
+        map.put(Blocks.CAKE, Data.get((level, pos, state) -> {
+            double size = pixel6 / pixel14 - pixel1;
+            return consumer(state, size, size, size, pixel6 - pixel8 * size + (pixel1 / 2));
+        }));
+    }
+
+    private static Consumer<Display.BlockDisplay> normalInteraction(Level level, BlockPos pos, BlockState blockState) {
+        return consumer(blockState);
+    }
+
+    private static Consumer<Display.BlockDisplay> originalInteraction(Level level, BlockPos pos, BlockState blockState) {
+        return consumer(blockState, 1.0);
+    }
+
+    private static Consumer<Display.BlockDisplay> hangingInteraction(Level level, BlockPos pos, BlockState blockState) {
+        return normalInteraction(level, pos, blockState).andThen(consumerInvert());
+    }
+
+    private static Consumer<Display.BlockDisplay> flatInteraction(Level level, BlockPos pos, BlockState blockState) {
+        return normalInteraction(level, pos, blockState).andThen(consumerFlat());
+    }
+
+    private static Consumer<Display.BlockDisplay> sphericalInteraction(Level level, BlockPos pos, BlockState blockState) {
+        return consumer(blockState, pixel8);
+    }
+
+    private static Consumer<Display.BlockDisplay> cropInteraction(Level level, BlockPos pos, BlockState blockState) {
+        return consumer(blockState, pixel12);
+    }
+
+    private static Consumer<Display.BlockDisplay> cropCircularInteraction(Level level, BlockPos pos, BlockState blockState) {
+        return consumer(blockState, pixel8 - 1.0E-4, pixel8 + pixel1, pixel8 - 1.0E-4).andThen(consumerFlat());
+    }
+
+    static @Nullable Consumer<Display.BlockDisplay> defaultInteraction(Level level, BlockPos pos, BlockState blockState) {
+        if (blockState.is(BlockTags.WALLS)) {
+            return consumer(blockState, pixel4 / pixel8, pixel12, pixel4 / pixel8);
+        }
+
+        if (blockState.hasProperty(HorizontalDirectionalBlock.FACING)) {
+            return null;
+        }
+
+        VoxelShape voxelShape = blockState.getShape(level, pos);
+        if (voxelShape.isEmpty()) {
+            return null;
+        }
+
+        AABB bounds = voxelShape.bounds();
+        if (bounds.minY != 0) {
+            return null;
+        }
+
+        double xsize = bounds.getXsize();
+        double ysize = bounds.getYsize();
+        double zsize = bounds.getZsize();
+        if (xsize <= pixel4 && zsize <= pixel4 && ysize >= pixel4 && ysize <= pixel12) {
+            return FlowerPotInteraction.originalInteraction(level, pos, blockState);
+        } else if (xsize <= pixel6 && zsize <= pixel6 && ysize >= pixel6) {
+            return FlowerPotInteraction.normalInteraction(level, pos, blockState);
+        } else {
+            return null;
+        }
+    }
+
+    private static Consumer<Display.BlockDisplay> consumer(BlockState blockState) {
+        return consumer(blockState, pixel12);
+    }
+
+    private static Consumer<Display.BlockDisplay> consumer(BlockState blockState, double size) {
+        return consumer(blockState, size, size, size);
+    }
+
+    private static Consumer<Display.BlockDisplay> consumer(BlockState blockState, double xsize, double ysize, double zsize) {
+        return consumer(blockState, xsize, ysize, zsize, pixel4);
+    }
+
+    private static Consumer<Display.BlockDisplay> consumer(BlockState blockState, double xsize, double ysize, double zsize, double floorY) {
+        return blockDisplay -> {
+            blockDisplay.setScaleCenterFloor(xsize, ysize, zsize, floorY);
+            blockDisplay.setBlockState(blockState);
+        };
+    }
+
+    private static Consumer<Display.BlockDisplay> consumerInvert() {
+        return Display::setInvert;
+    }
+
+    private static Consumer<Display.BlockDisplay> consumerFlat() {
+        return display -> display.setTranslation(display.getTranslation().add(0.0F, (float) pixel2, 0.0F));
+    }
+
+    record Data(FlowerPotInteraction interaction, Function<Block, BlockState> blockStateGenerator) {
+        private static Data get(FlowerPotInteraction interaction) {
+            return new Data(interaction, Block::defaultBlockState);
+        }
+
+        private static Data get(FlowerPotInteraction interaction, Block fixed) {
+            return new Data(interaction, block -> fixed.defaultBlockState());
+        }
+
+        private static Data get(FlowerPotInteraction interaction, Function<BlockState, BlockState> defaultStateFunction) {
+            return new Data(interaction, block -> defaultStateFunction.apply(block.defaultBlockState()));
+        }
+
+        private static Data get(FlowerPotInteraction interaction, Block fixed, Function<BlockState, BlockState> defaultStateFunction) {
+            return new Data(interaction, block -> defaultStateFunction.apply(fixed.defaultBlockState()));
+        }
+
+        private <T extends Comparable<T>, V extends T> Data randomProperty(Property<?>... properties) {
+            return new Data(this.interaction, this.blockStateGenerator.andThen(blockState -> {
+                for (Property<?> property : properties) {
+                    if (property instanceof BooleanProperty booleanProperty) {
+                        blockState = blockState.setValue(booleanProperty, RANDOM.nextBoolean());
+                    } else {
+                        List<?> possibleValues = property.getPossibleValues();
+                        blockState = blockState.setValue((Property<T>) property, (V) possibleValues.get(RANDOM.nextInt(possibleValues.size())));
+                    }
+                }
+                return blockState;
+            }));
+        }
+    }
+}
+// KioCG end - custom block entity: all class
