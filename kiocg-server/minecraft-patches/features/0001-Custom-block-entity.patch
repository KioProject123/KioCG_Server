+    }
+
+    private interface PottedTick {
+        PottedTick NONE = (level, pos, pottedState) -> {
+        };
+
+        void tick(ServerLevel level, BlockPos pos, BlockState pottedState);
+
+        private static PottedTick pottedTick(FlowerPotBlockEntity flowerPot) {
+            if (!flowerPot.isEmpty()) {
+                BlockState pottedState = flowerPot.getPottedState();
+                if (pottedState.is(Blocks.TORCH)) {
+                    return (level, pos, state) -> {
+                        PottedTick.torchTick(level, pos, state, ParticleTypes.FLAME);
+                    };
+                } else if (pottedState.is(Blocks.SOUL_TORCH)) {
+                    return (level, pos, state) -> {
+                        PottedTick.torchTick(level, pos, state, ParticleTypes.SOUL_FIRE_FLAME);
+                    };
+                } else if (pottedState.is(Blocks.REDSTONE_TORCH)) {
+                    if (pottedState.getValue(RedstoneTorchBlock.LIT)) {
+                        return PottedTick::redstoneTorchTick;
+                    }
+                } else if (pottedState.is(Blocks.SPORE_BLOSSOM)) {
+                    return PottedTick::sporeBlossomTick;
+                } else if (pottedState.is(Blocks.FIREFLY_BUSH)) {
+                    return PottedTick::fireflyBushTick;
+                } else {
+                    boolean isCandle = pottedState.is(BlockTags.CANDLES);
+                    if (isCandle || pottedState.is(BlockTags.CANDLE_CAKES)) {
+                        if (pottedState.getValueOrElse(AbstractCandleBlock.LIT, false)) {
+                            return (level, pos, state) -> {
+                                PottedTick.candleTick(level, pos, state, isCandle ? 0.5 + 0.25 : 0.65);
+                            };
+                        }
+                    }
+                }
+            }
+            return NONE;
+        }
+
+        private static void torchTick(ServerLevel level, BlockPos pos, BlockState pottedState, SimpleParticleType flameParticle) {
+            if (level.random.nextFloat() < (float) (1.0 / 8.0)) {
+                double d = pos.getX() + 0.5;
+                double d1 = pos.getY() + 0.7 + 0.25;
+                double d2 = pos.getZ() + 0.5;
+                level.sendParticles(ParticleTypes.SMOKE, d, d1, d2, 1, 0.0, 0.0, 0.0, 0.0);
+                level.sendParticles(flameParticle, d, d1, d2, 1, 0.0, 0.0, 0.0, 0.0);
+            }
+        }
+
+        private static void redstoneTorchTick(ServerLevel level, BlockPos pos, BlockState pottedState) {
+            if (level.random.nextFloat() < (float) (1.0 / 8.0)) {
+                double d = pos.getX() + 0.5 + (level.random.nextDouble() - 0.5) * 0.2;
+                double d1 = pos.getY() + 0.7 + 0.25 + (level.random.nextDouble() - 0.5) * 0.2;
+                double d2 = pos.getZ() + 0.5 + (level.random.nextDouble() - 0.5) * 0.2;
+                level.sendParticles(DustParticleOptions.REDSTONE, d, d1, d2, 1, 0.0, 0.0, 0.0, 0.0);
+            }
+        }
+
+        private static void candleTick(ServerLevel level, BlockPos pos, BlockState pottedState, double yoffset) {
+            if (level.random.nextFloat() < (float) (1.0 / 8.0)) {
+                AbstractCandleBlock.addParticlesAndSound(level, new Vec3(pos.getX() + 0.5, pos.getY() + yoffset, pos.getZ() + 0.5), level.random);
+            }
+        }
+
+        private static void sporeBlossomTick(ServerLevel level, BlockPos pos, BlockState pottedState) {
+            if (level.random.nextFloat() < (float) (1.0 / 20.0)) {
+                level.sendParticles(ParticleTypes.SPORE_BLOSSOM_AIR, pos.getX() + 0.5, pos.getY() + 1.0, pos.getZ() + 0.5, 2, 0.5, 0.5, 0.5, 0.0);
+            }
+        }
+
+        private static void fireflyBushTick(ServerLevel level, BlockPos pos, BlockState pottedState) {
+            if (level.random.nextFloat() < (float) (1.0 / 8.0)) {
+                pottedState.getBlock().animateTick(pottedState, level, pos, level.random);
+            }
+        }
+    }
