@@ -68,7 +68,10 @@ public class DeltaFeature extends Feature<DeltaFeatureConfiguration> {
             return false;
         } else {
             for (Direction direction : DIRECTIONS) {
-                boolean isAir = level.getBlockState(pos.relative(direction)).isAir();
+                // KioCG start - datapack fix: 落叶会导致流体错误生成
+                BlockState blockState1 = level.getBlockState(pos.relative(direction));
+                boolean isAir = !blockState1.getBlock().hasCollision && !blockState1.is(config.contents().getBlock());
+                // KioCG end - datapack fix: 落叶会导致流体错误生成
                 if (isAir && direction != Direction.UP || !isAir && direction == Direction.UP) {
                     return false;
                 }
diff --git a/net/minecraft/world/level/levelgen/feature/TreeFeature.java b/net/minecraft/world/level/levelgen/feature/TreeFeature.java
index ef444a4975cb7b24b6dc3b0e6b8d727265bf6011..b9996d9bc8bf007f1b97d1c9e932c664d01363f4 100644
