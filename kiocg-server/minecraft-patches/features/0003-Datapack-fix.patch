+++ b/net/minecraft/world/level/levelgen/feature/TreeFeature.java
@@ -40,6 +40,18 @@ public class TreeFeature extends Feature<TreeConfiguration> {
         return level.isStateAtPosition(pos, state -> state.is(Blocks.VINE));
     }
 
+    // KioCG start - datapack fix: 修复悬空的藤蔓
+    public static void tryCleanHangingVine(LevelSimulatedReader level, BlockPos pos) {
+        if (level instanceof LevelWriter && TreeFeature.isVine(level, pos)) {
+            BlockPos.MutableBlockPos mutablePos = new BlockPos.MutableBlockPos();
+            mutablePos.set(pos);
+            while (TreeFeature.isVine(level, mutablePos.move(Direction.DOWN))) {
+                ((LevelWriter) level).setBlock(mutablePos, Blocks.AIR.defaultBlockState(), 2);
+            }
+        }
+    }
+    // KioCG end - datapack fix: 修复悬空的藤蔓
+
     public static boolean isAirOrLeaves(LevelSimulatedReader level, BlockPos pos) {
         return level.isStateAtPosition(pos, state -> state.isAir() || state.is(BlockTags.LEAVES));
     }
