+
+        public boolean dontKillMyPet = true;
+        public double petTeleportDistanceSqr = 256.0;
+        public boolean petFollowKeepChunkLoaded = true;
+        public Component sleepProgressClock = Component.text("\uD83D\uDE34");
+        public Component sleepProgressLeft = Component.text("☽", NamedTextColor.BLUE);
+        public Component sleepProgressRight = Component.text("☀", NamedTextColor.YELLOW);
+        public String sleepProgressContent = "                              ";
+    }
+    // KioCG end
