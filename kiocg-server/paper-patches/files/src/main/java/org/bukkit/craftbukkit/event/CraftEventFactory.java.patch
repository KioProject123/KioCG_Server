+    private static PlayerEvent getPlayerBottleEvent(boolean isFilling, Level world, net.minecraft.world.entity.player.Player player, BlockPos clicked, ItemStack bottle, ItemStack result, InteractionHand hand) {
+        Player cplayer = (Player) player.getBukkitEntity();
+        org.bukkit.inventory.ItemStack bottleItem = CraftItemStack.asBukkitCopy(bottle);
+        CraftItemStack resultItem = CraftItemStack.asCraftMirror(result);
+
+        Block clickedBlock = CraftBlock.at(world, clicked);
+        EquipmentSlot handSlot = CraftEquipmentSlot.getHand(hand);
+
+        PlayerEvent event;
+        if (isFilling) {
+            event = new com.kiocg.event.player.PlayerBottleFillEvent(cplayer, clickedBlock, bottleItem, resultItem, handSlot);
+        } else {
+            event = new com.kiocg.event.player.PlayerBottleEmptyEvent(cplayer, clickedBlock, bottleItem, resultItem, handSlot);
+        }
+
+        event.callEvent();
+
+        return event;
+    }
