+    @Override
+    public void sendSpawn(List<Player> players, Location location) {
+        Preconditions.checkNotNull(players, "players cannot be null");
+        Preconditions.checkArgument(!players.isEmpty(), "players cannot be empty");
+        Preconditions.checkNotNull(location, "location cannot be null");
+        this.entity.setLevel(((CraftWorld) location.getWorld()).getHandle());
+        this.entity.setPos(location.getX(), location.getY(), location.getZ());
+        this.entity.setRot(location.getYaw(), location.getPitch());
+        this.entity.getSelfAndPassengers().forEach(entity -> {
+            List<ServerPlayer> serverPlayers = players.stream().map(player -> ((CraftPlayer) player).getHandle()).toList();
+            entity.getBukkitEntity().runVirtualEntity(serverPlayers, serverEntity -> {
+                List<net.minecraft.network.protocol.Packet<? super net.minecraft.network.protocol.game.ClientGamePacketListener>> list = new java.util.ArrayList<>();
+                serverEntity.sendPairingData(serverPlayers.getFirst(), list::add); // 玩家参数不重要
+                for (ServerPlayer serverPlayer : serverPlayers) {
+                    serverPlayer.connection.send(new net.minecraft.network.protocol.game.ClientboundBundlePacket(list));
+                }
+            });
+        });
+    }
