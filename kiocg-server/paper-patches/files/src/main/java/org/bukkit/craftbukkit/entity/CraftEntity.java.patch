+    private void runVirtualEntity(List<ServerPlayer> players, java.util.function.Consumer<net.minecraft.server.level.ServerEntity> run) {
+        Preconditions.checkArgument(!isInWorld(), "Entity is real");
+        if (virtualEntity == null) {
+            virtualEntity = entity.serverLevel().getChunkSource().chunkMap.getTrackedEntity(entity, 0, 1, entity.getType());
+        }
+
+        try {
+            for (ServerPlayer player : players) {
+                virtualEntity.seenBy.add(player.connection);
+            }
+            run.accept(virtualEntity.serverEntity);
+        } finally {
+            virtualEntity.seenBy.clear();
+        }
+    }
