+    class UUIDPersistentDataType implements PersistentDataType<String, java.util.UUID> {
+
+        @NotNull
+        @Override
+        public Class<String> getPrimitiveType() {
+            return String.class;
+        }
+
+        @NotNull
+        @Override
+        public Class<java.util.UUID> getComplexType() {
+            return java.util.UUID.class;
+        }
+
+        @NotNull
+        @Override
+        public String toPrimitive(java.util.UUID complex, PersistentDataAdapterContext context) {
+            return complex.toString();
+        }
+
+        @NotNull
+        @Override
+        public java.util.UUID fromPrimitive(String primitive, PersistentDataAdapterContext context) {
+            return java.util.UUID.fromString(primitive);
+        }
+    }
+
+    class LocationPersistentDataType implements PersistentDataType<PersistentDataContainer, org.bukkit.Location> {
+
+        @NotNull
+        @Override
+        public Class<PersistentDataContainer> getPrimitiveType() {
+            return PersistentDataContainer.class;
+        }
+
+        @NotNull
+        @Override
+        public Class<org.bukkit.Location> getComplexType() {
+            return org.bukkit.Location.class;
+        }
+
+        @NotNull
+        @Override
+        public PersistentDataContainer toPrimitive(@NotNull org.bukkit.Location complex, @NotNull PersistentDataAdapterContext context) {
+            PersistentDataContainer container = context.newPersistentDataContainer();
+            container.set(org.bukkit.NamespacedKey.kiocg("world"), PersistentDataType.STRING, complex.getWorld().getName());
+            container.set(org.bukkit.NamespacedKey.kiocg("pos"), PersistentDataType.LIST.doubles(), java.util.Arrays.asList(complex.getX(), complex.getY(), complex.getZ()));
+            container.set(org.bukkit.NamespacedKey.kiocg("rotation"), PersistentDataType.LIST.floats(), java.util.Arrays.asList(complex.getYaw(), complex.getPitch()));
+            return container;
+        }
+
+        @NotNull
+        @Override
+        public org.bukkit.Location fromPrimitive(@NotNull PersistentDataContainer primitive, @NotNull PersistentDataAdapterContext context) {
+            String world = java.util.Objects.requireNonNull(primitive.get(org.bukkit.NamespacedKey.kiocg("world"), PersistentDataType.STRING));
+            java.util.List<Double> pos = java.util.Objects.requireNonNull(primitive.get(org.bukkit.NamespacedKey.kiocg("pos"), PersistentDataType.LIST.doubles()));
+            java.util.List<Float> rotation = java.util.Objects.requireNonNull(primitive.get(org.bukkit.NamespacedKey.kiocg("rotation"), PersistentDataType.LIST.floats()));
+            return new org.bukkit.Location(org.bukkit.Bukkit.getWorld(world), pos.get(0), pos.get(1), pos.get(2), rotation.get(0), rotation.get(1));
+        }
+    }
+
+    class ItemStackPersistentDataType implements PersistentDataType<String, org.bukkit.inventory.ItemStack> {
+
+        @NotNull
+        @Override
+        public Class<String> getPrimitiveType() {
+            return String.class;
+        }
+
+        @NotNull
+        @Override
+        public Class<org.bukkit.inventory.ItemStack> getComplexType() {
+            return org.bukkit.inventory.ItemStack.class;
+        }
+
+        @NotNull
+        @Override
+        public String toPrimitive(@NotNull org.bukkit.inventory.ItemStack complex, @NotNull PersistentDataAdapterContext context) {
+            return java.util.Base64.getEncoder().encodeToString(complex.serializeAsBytes());
+        }
+
+        @NotNull
+        @Override
+        public org.bukkit.inventory.ItemStack fromPrimitive(@NotNull String primitive, @NotNull PersistentDataAdapterContext context) {
+            return org.bukkit.inventory.ItemStack.deserializeBytes(java.util.Base64.getDecoder().decode(primitive));
+        }
+    }
