+    class EntityPersistentDataType implements PersistentDataType<String, org.bukkit.entity.Entity> {
+        org.bukkit.World world;
+        boolean preserveUUID;
+
+        public EntityPersistentDataType(@NotNull org.bukkit.World world, boolean preserveUUID) {
+            this.world = world;
+            this.preserveUUID = preserveUUID;
+        }
+
+        private EntityPersistentDataType() {
+        }
+
+        @NotNull
+        @Override
+        public Class<String> getPrimitiveType() {
+            return String.class;
+        }
+
+        @NotNull
+        @Override
+        public Class<org.bukkit.entity.Entity> getComplexType() {
+            return org.bukkit.entity.Entity.class;
+        }
+
+        @NotNull
+        @Override
+        public String toPrimitive(@NotNull org.bukkit.entity.Entity complex, @NotNull PersistentDataAdapterContext context) {
+            return java.util.Base64.getEncoder().encodeToString(org.bukkit.Bukkit.getUnsafe().serializeEntity(complex));
+        }
+
+        @NotNull
+        @Override
+        public org.bukkit.entity.Entity fromPrimitive(@NotNull String primitive, @NotNull PersistentDataAdapterContext context) {
+            if (this.world == null) {
+                this.world = org.bukkit.Bukkit.getWorlds().getFirst();
+            }
+            return org.bukkit.Bukkit.getUnsafe().deserializeEntity(java.util.Base64.getDecoder().decode(primitive), this.world, this.preserveUUID);
+        }
+    }
